{
  "name": "fulgurlab",
  "version": "0.1.0",
  "private": true,
  "description": "A basic Simulink-style block diagram simulator for the browser, backed by headless Scilab/Xcos",
  "scripts": {
    "install:all": "npm --prefix web install",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "npm --prefix server test",
    "typecheck": "npm --prefix web run typecheck",
    "start": "npm --prefix server start"
  },
  "engines": { "node": ">=20" }
}
