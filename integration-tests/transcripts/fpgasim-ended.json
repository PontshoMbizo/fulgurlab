{
  "backend": "fpgasim",
  "note": "SPEC-DERIVED, NOT RECORDED. Shape of a session that hits $finish, per docs/bridge-protocol.md's `ended` row; the handshake/created frames are copied from the real fpgasim-divider.json recording.",
  "session": "s-fake",
  "frames": [
    { "on": "hello", "send": { "type": "welcome", "proto": 1, "backend": "fpgasim", "version": "1.0.0" } },
