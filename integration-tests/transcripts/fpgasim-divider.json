{
  "backend": "fpgasim",
  "note": "recorded from the real fpgasim bridge + iverilog/vvp: a Verilog counter that toggles q every 13000 board-clock posedges",
  "session": "s-fake",
  "frames": [
    {
      "on": "hello",
      "send": {
        "type": "welcome",
        "proto": 1,
        "backend": "fpgasim",
        "version": "1.0.0"
      }
    },
    {
      "on": "create",
      "send": {
        "type": "created",
        "session": "{{session}}",
        "pins": [
          {
            "name": "en",
            "dir": "in"
          },
          {
            "name": "q",
            "dir": "out"
          }
        ],
        "quantum_ns": 500000
      }
    },
    {
      "on": "step",
      "send": {
        "type": "stepped",
        "session": "{{session}}",
        "t_ns": 500000,
        "outputs": {
          "q": 1
        },
        "events": [
          [
            481475,
            "q",
            1
          ]
        ]
      }
    },
    {
      "on": "step",
      "send": {
        "type": "stepped",
        "session": "{{session}}",
        "t_ns": 1000000,
        "outputs": {
          "q": 0
        },
        "events": [
          [
            962969,
            "q",
            0
          ]
        ]
      }
    },
    {
      "on": "step",
      "send": {
        "type": "stepped",
        "session": "{{session}}",
        "t_ns": 1500000,
        "outputs": {
          "q": 1
        },
        "events": [
          [
            1444463,
            "q",
            1
          ]
        ]
      }
    },
    {
      "on": "reset",
      "send": {
        "type": "error",
        "stage": "proto",
        "log": "reset not supported in v1 — dispose and create",
        "session": "{{session}}"
      }
    },
    {
      "on": "dispose",
      "send": {
        "type": "disposed",
        "session": "{{session}}"
      }
    }
  ]
}
