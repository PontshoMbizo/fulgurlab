{
  "version": 1,
  "name": "PID loop with a subsystem",
  "description": "The PID position loop with the controller and plant wrapped in one subsystem. Double-click the Forward path block to open it. The response is identical to the flat PID example.",
  "settings": {
    "tf": 10,
    "dt": 0.01
  },
  "blocks": [
    {
      "id": "ref",
      "type": "step",
      "params": {
        "time": 0.5
      },
      "x": 40,
      "y": 140,
      "name": "Reference"
    },
    {
      "id": "err",
      "type": "sum",
      "params": {
        "signs": "+-"
      },
      "x": 200,
      "y": 140,
      "name": "Error"
    },
    {
      "id": "fwd",
      "type": "subsystem",
      "params": {},
      "x": 340,
      "y": 132,
      "name": "Forward path",
      "system": {
        "blocks": [
          {
            "id": "in",
            "type": "inport",
            "params": {
              "index": 1
            },
            "x": 40,
            "y": 120,
            "name": "Error"
          },
          {
            "id": "pid",
            "type": "pid",
            "params": {
              "kp": 4,
              "ki": 2,
              "kd": 1,
              "n": 100
            },
            "x": 160,
            "y": 112,
            "name": "Controller"
          },
          {
            "id": "plant",
            "type": "transferFn",
            "params": {
              "num": [
                1
              ],
              "den": [
                1,
                2,
                1
              ]
            },
            "x": 340,
            "y": 112,
            "name": "Plant"
          },
          {
            "id": "out",
            "type": "outport",
            "params": {
              "index": 1
            },
            "x": 560,
            "y": 120,
            "name": "Output"
          }
        ],
        "links": [
          {
            "from": {
              "block": "in",
              "port": 0
            },
            "to": {
              "block": "pid",
              "port": 0
            }
          },
          {
            "from": {
              "block": "pid",
              "port": 0
            },
            "to": {
              "block": "plant",
              "port": 0
            }
          },
          {
            "from": {
              "block": "plant",
              "port": 0
            },
            "to": {
              "block": "out",
              "port": 0
            }
          }
        ]
      }
    },
    {
      "id": "scope",
      "type": "scope",
      "params": {
        "inputs": 2
      },
      "x": 560,
      "y": 120,
      "name": "Response"
    }
  ],
  "links": [
    {
      "from": {
        "block": "ref",
        "port": 0
      },
      "to": {
        "block": "err",
        "port": 0
      }
    },
    {
      "from": {
        "block": "err",
        "port": 0
      },
      "to": {
        "block": "fwd",
        "port": 0
      }
    },
    {
      "from": {
        "block": "fwd",
        "port": 0
      },
      "to": {
        "block": "err",
        "port": 1
      }
    },
    {
      "from": {
        "block": "ref",
        "port": 0
      },
      "to": {
        "block": "scope",
        "port": 0
      }
    },
    {
      "from": {
        "block": "fwd",
        "port": 0
      },
      "to": {
        "block": "scope",
        "port": 1
      }
    }
  ]
}
