#!/bin/sh
# Minimal stand-in for dpkg-dev's dpkg-architecture.
#
# Ubuntu's /usr/bin/scilab-cli calls `dpkg-architecture -qDEB_HOST_MULTIARCH`
# to find /usr/lib/<triplet>/scilab. Installing dpkg-dev for that would pull in
# perl, make and binutils, so the image ships this instead. Only the queries the
# launcher makes are supported.
case "$1" in
  -qDEB_HOST_MULTIARCH|-qDEB_BUILD_MULTIARCH)
    case "$(uname -m)" in
      x86_64)  echo x86_64-linux-gnu ;;
      aarch64) echo aarch64-linux-gnu ;;
      *)       echo "$(uname -m)-linux-gnu" ;;
    esac ;;
  *)
    echo "dpkg-architecture stand-in: unsupported query '$*'" >&2
    exit 2 ;;
esac
